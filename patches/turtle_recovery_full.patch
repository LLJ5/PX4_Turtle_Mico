+	const bool pending_turtle = _turtle_control_sub.copy(&turtle_control) && turtle_control.timestamp != 0
+				    && turtle_now >= turtle_control.timestamp && turtle_now - turtle_control.timestamp < 200000
+				    && turtle_control.action != turtle_recovery_control_s::ACTION_STOP;
+	int32_t turtle_enabled = 0;
+	param_get(param_find("TRTL_ENABLE"), &turtle_enabled);
+
+	if (_turtle_arming_inhibit || pending_turtle || (turtle_enabled != 0 && !feedback_fresh)) {
