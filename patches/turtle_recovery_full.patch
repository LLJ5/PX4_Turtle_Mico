+	if (have_feedback && (turtle_feedback.busy || turtle_feedback.direction_dirty)) { _turtle_arming_inhibit = true; }
+
+	if (feedback_fresh && !turtle_feedback.busy && !turtle_feedback.direction_dirty) { _turtle_arming_inhibit = false; }
